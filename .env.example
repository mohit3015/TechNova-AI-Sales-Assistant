# Application Configuration
APP_ENV=development
APP_NAME="TechNova AI Sales Assistant"
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration (Authoritative for pricing, specs, inventory)
DATABASE_URL=sqlite:///./technova_store.db

# Vector Database (Authoritative for semantic search, descriptions, policies, FAQs)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=technova_knowledge

# Embeddings (Local CPU friendly, 384-dimensional)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Configuration (OpenRouter / Groq / HuggingFace)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_MODEL=meta-llama/llama-3-8b-instruct:free

# Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K_RETRIEVAL=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
